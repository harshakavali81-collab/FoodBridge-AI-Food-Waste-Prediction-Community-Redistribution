APP_ENV=development
DATABASE_URL=sqlite:///./foodbridge.db
SEED_DEMO_DATA=true
API_KEY=
# Only enable local, fictional recipient demo verification after setting a strong value
DEMO_ADMIN_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_MATCH_DISTANCE_KM=20
# Optional signed-identity pilot-review sandbox; NEVER use test keys in production.
# OIDC_PUBLIC_KEY_PEM accepts escaped newline sequences (\\n).
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_PUBLIC_KEY_PEM=
