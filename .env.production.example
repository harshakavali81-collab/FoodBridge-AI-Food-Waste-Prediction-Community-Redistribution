# INTERNAL STAGING EXAMPLE; not a functional real-food production release.
APP_ENV=production
SEED_DEMO_DATA=false
ENABLE_REAL_OPERATIONS=false
# Strong URL-safe 32+ character secret; never put it into a browser or commit it
API_KEY=REPLACE_WITH_A_RANDOM_SERVER_SIDE_SECRET_32_OR_MORE_CHARACTERS
# URL-safe database credential e.g. hex; PostgreSQL is accessed on a private network
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_URL_SAFE_SECRET
CORS_ORIGINS=
