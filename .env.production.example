# STAGING ONLY. Production APP_ENV blocks operational writes by design.
APP_ENV=production
SEED_DEMO_DATA=false
ENABLE_REAL_OPERATIONS=false
DATABASE_URL=postgresql+psycopg://foodbridge:REPLACE_WITH_STRONG_PASSWORD@db:5432/foodbridge
# Generate server-only 32+ character token, not a frontend variable
API_KEY=REPLACE_WITH_32_PLUS_RANDOM_SERVER_SIDE_CHARACTERS
CORS_ORIGINS=
